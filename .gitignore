# Bioinformatics specific files

# Large data files
data/**/*.fasta
data/**/*.gaf
data/**/*.obo
data/**/*.hmm

# Results and databases
results/*.db
results/*.sqlite
results/checkpoints/

# Temporary files
.DS_Store
Thumbs.db

# Large compressed archives
*.gz

# uv specific
.python-version

# Junk to ignore
data/interim/human_proteins.txt

# Full per-ontology run output is regenerable and runs to tens of MB. The
# `_top100` summaries are small and are tracked, so a reader can see what a run
# produced without the repository carrying the whole table.
results*/domain_*_associations_significant.tsv
# Run manifests belong with the results they describe. A run whose outputs are
# not tracked should not leave its manifest behind either — one slipped in from
# a scratch directory in #46.
results*/**/run_manifest_*.json
results*/run_manifest_*.json
results*/domain_*_annotations_propagated.tsv
results*/domain_*_surprising.tsv

# Generated analysis output directories
results_*/

data/raw/interpro_mappings/interpro2go

validation*_path/*
results*_path/*

# Downloaded raw datasets (large; fetched via scripts/download_data.py)
data/raw/
data/interim/
*.dat.gz

# Run logs are scratch, except the benchmark logs committed as provenance
# (see validation/BENCHMARK_ARTIFACTS.md).
logs/

# Ablation ladder pipeline output (VALIDATION_PLAN §4). Each rung is a full
# domain x GO association table (~17 MB); the metrics derived from them are
# committed instead (validation/ablation_*.tsv).
results/ablation/
